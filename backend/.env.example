# SQLite Database URL
DATABASE_URL=sqlite:///./database.db

# API Prefix
API_PREFIX=/api
DEBUG=True

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Groq API Key (Get yours at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
